from __future__ import annotations

import math
import os
import re
from typing import Any, Optional

from dotenv import load_dotenv
from fastapi import Depends, FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, EmailStr, Field

load_dotenv()

app = FastAPI(title="HCMUS Ăn Gì API")
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

CAMPUSES = {
    "q5": {"lat": 10.762622, "lng": 106.68236, "short": "Quận 5"},
    "lang": {"lat": 10.87005, "lng": 106.8004, "short": "Làng ĐH"},
}


def haversine(a_lat: float, a_lng: float, b_lat: float, b_lng: float) -> float:
    r = 6371000.0
    d_lat = math.radians(b_lat - a_lat)
    d_lng = math.radians(b_lng - a_lng)
    s = (
        math.sin(d_lat / 2) ** 2
        + math.cos(math.radians(a_lat))
        * math.cos(math.radians(b_lat))
        * math.sin(d_lng / 2) ** 2
    )
    return 2 * r * math.asin(min(1.0, math.sqrt(s)))


# --- Intent (mirror frontend) -------------------------------------------------

CAMPUS_Q5 = re.compile(r"quận\s*5|q\.?\s*5|nguyễn văn cừ|nvc", re.I)
CAMPUS_LANG = re.compile(r"làng|linh trung|thủ đức|lang dai hoc|làng đại học", re.I)


def parse_money(text: str) -> Optional[int]:
    m = re.search(
        r"(?:dưới|duoi|tối đa|toi da|max|<)\s*(\d+(?:[.,]\d+)?)\s*(k|nghìn|nghin|tr)?",
        text,
        re.I,
    ) or re.search(r"(\d+(?:[.,]\d+)?)\s*(k|nghìn|nghin|triệu|trieu|tr)\b", text, re.I)
    if not m:
        return None
    raw = float(m.group(1).replace(",", "."))
    unit = (m.group(2) or "").lower()
    if unit.startswith("tr"):
        return int(raw * 1_000_000)
    if unit in ("k",) or unit.startswith("ngh"):
        return int(raw * 1000)
    if raw < 500:
        return int(raw * 1000)
    return int(raw)


def parse_radius(text: str) -> Optional[int]:
    m = re.search(r"(\d+(?:[.,]\d+)?)\s*(km|m|mét|met)\b", text, re.I)
    if not m:
        return None
    n = float(m.group(1).replace(",", "."))
    return int(n * 1000) if m.group(2).lower() == "km" else int(n)


class ChatBody(BaseModel):
    message: str
    campus: Optional[str] = None
    budget: Optional[int] = None
    radius_m: Optional[int] = None


@app.post("/chat")
def chat(body: ChatBody) -> dict[str, Any]:
    campus = body.campus
    budget = body.budget
    radius_m = body.radius_m
    text = body.message

    if CAMPUS_Q5.search(text):
        campus = "q5"
    if CAMPUS_LANG.search(text):
        campus = "lang"
    money = parse_money(text)
    if money is not None:
        budget = money
    rad = parse_radius(text)
    if rad is not None:
        radius_m = rad

    if not campus:
        return {
            "ready": False,
            "campus": campus,
            "budget": budget,
            "radius_m": radius_m,
            "reply": "Bạn đang ở cơ sở nào — Quận 5 (Nguyễn Văn Cừ) hay Làng Đại học?",
        }
    if not budget:
        return {
            "ready": False,
            "campus": campus,
            "budget": budget,
            "radius_m": radius_m,
            "reply": f"Ngân sách tối đa mỗi người? Ví dụ: dưới 40k. Đang lọc quanh {CAMPUSES[campus]['short']}.",
        }
    if not radius_m:
        return {
            "ready": False,
            "campus": campus,
            "budget": budget,
            "radius_m": radius_m,
            "reply": "Bạn muốn đi bộ trong bao xa? Ví dụ: 500m hoặc 1km.",
        }

    # TODO: gọi Gemini nếu GEMINI_API_KEY có trong env (giữ logic hỏi slot).
    return {
        "ready": True,
        "campus": campus,
        "budget": budget,
        "radius_m": radius_m,
        "reply": (
            f"Được. Ghim quán quanh {CAMPUSES[campus]['short']}, "
            f"tối đa {budget:,}đ, trong {radius_m}m."
        ),
    }


class PlaceOut(BaseModel):
    id: int
    name: str
    campus: str
    lat: float
    lng: float
    price_min: int
    price_max: int
    cuisine: str
    address: str
    hours: str
    meters: float


# Seed in-memory nếu chưa nối MySQL (dev)
_SEED = [
    {
        "id": 1,
        "name": "Cơm tấm Mười",
        "campus": "q5",
        "lat": 10.7639,
        "lng": 106.6812,
        "price_min": 30000,
        "price_max": 45000,
        "cuisine": "Cơm",
        "address": "Hẻm 215 Nguyễn Văn Cừ, Q.5",
        "hours": "6:00–14:00",
    },
    {
        "id": 9,
        "name": "Cơm gà xối mỡ",
        "campus": "lang",
        "lat": 10.8716,
        "lng": 106.8002,
        "price_min": 35000,
        "price_max": 50000,
        "cuisine": "Cơm",
        "address": "Khu phố 6, Linh Trung",
        "hours": "10:00–21:00",
    },
]


@app.get("/places")
def list_places(
    campus: str = "q5",
    budget: int = 50000,
    radius_m: int = 800,
) -> list[dict[str, Any]]:
    if campus not in CAMPUSES:
        raise HTTPException(400, "campus must be q5 or lang")
    origin = CAMPUSES[campus]
    out = []
    for p in _SEED:
        if p["campus"] != campus:
            continue
        if p["price_min"] > budget:
            continue
        meters = haversine(origin["lat"], origin["lng"], p["lat"], p["lng"])
        if meters > radius_m:
            continue
        out.append({**p, "meters": round(meters)})
    out.sort(key=lambda x: x["meters"])
    return out


@app.get("/health")
def health() -> dict[str, str]:
    return {"status": "ok", "mysql": "optional-stub"}


